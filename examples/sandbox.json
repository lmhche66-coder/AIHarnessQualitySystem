{
  "sandbox": {
    "id": "demo-sandbox",
    "project": "agenteval-sandbox-demo",
    "compose_file": "sandbox/compose.yaml",
    "services": ["sleeper"],
    "health_services": ["sleeper"],
    "volumes": ["sleeper-data"],
    "reset": "recreate",
